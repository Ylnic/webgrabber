server {
    listen 80;
    listen [::]:80;
    server_name webgrabber.example.com www.webgrabber.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name webgrabber.example.com www.webgrabber.example.com;

    ssl_certificate /etc/letsencrypt/live/webgrabber.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/webgrabber.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
